          "legendFormat": "5xx/s",
          "refId": "B"
        }
      ],
      "title": "Erreurs API",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
