      "targets": [
        {
          "editorMode": "code",
          "expr": "topk(10, sum by (uri) (rate(http_server_requests_seconds_count{uri=~\"/api/.*\",status=~\"4..|5..\",instance=~\"$server(:.*)?\"}[5m]))) or topk(10, sum by (uri) (rate(http_server_requests_seconds_count{uri=~\"/api/.*\",status=~\"4..|5..\"}[5m])))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ],
