          "editorMode": "code",
          "expr": "sum(match_sessions{status=~\"OPEN|COMPLETED|CANCELED\",instance=~\"$server(:.*)?\"}) by (status) or sum(match_sessions{status=~\"OPEN|COMPLETED|CANCELED\"}) by (status)",
